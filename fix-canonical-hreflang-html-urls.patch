 <script type="application/ld+json">{"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "ما هي Orion Private Wealth Consulting؟", "acceptedAnswer": {"@type": "Answer", "text": "Orion هي وسيط خاص للعملاء الباحثين عن وصول سري ومتخصص إلى أرقى أصول العالم — العقارات والسيارات والساعات. نُقدّم الفرص، نتفاوض، ونبقى إلى جانب عملائنا طوال الرحلة — من دبي إلى جبال الألب السويسرية والريفييرا الفرنسية."}}, {"@type": "Question", "name": "كيف يعمل نموذج الأتعاب مقابل النجاح لديكم؟", "acceptedAnswer": {"@type": "Answer", "text": "تعمل Orion وفق نموذج الأتعاب مقابل النجاح فقط. نحصل على أتعابنا فقط عند إتمام الصفقة لصالح العميل — لا شيء مسبقًا، ولا شيء بخلاف ذلك. مصالحنا متوافقة تمامًا مع مصالحكم."}}, {"@type": "Question", "name": "ما هي الأسواق وفئات الأصول التي تغطونها؟", "acceptedAnswer": {"@type": "Answer", "text": "نركّز على ثلاث فئات — العقارات الفاخرة والسيارات والساعات — في مناطق جغرافية مختارة تشمل دبي والإمارات عمومًا، منطقة إنغادين في سويسرا، والريفييرا الفرنسية."}}, {"@type": "Question", "name": "هل توجد قيمة دنيا للصفقة للعمل مع Orion؟", "acceptedAnswer": {"@type": "Answer", "text": "تعمل Orion وفق التكليف وليس الحجم. تُدرَس كل مهمة بشكل فردي، ضمن محادثة خاصة، لتحديد التوافق بين الطرفين."}}, {"@type": "Question", "name": "ما مدى سرية هذه العملية؟", "acceptedAnswer": {"@type": "Answer", "text": "السرية هي أساس عملنا. لا نكشف هويات عملائنا، ولا نُعلن تفاصيل الصفقات، ونبني كل تكليف حول الخصوصية من أول تواصل حتى إتمام الصفقة."}}, {"@type": "Question", "name": "هل تعملون مباشرة مع المطورين والوكلاء، أم كوسيط فقط؟", "acceptedAnswer": {"@type": "Answer", "text": "تعمل Orion كوسيط — نُعرّف العملاء بالفرص ونتفاوض نيابةً عنهم، معتمدين على علاقات مباشرة مع مطورين ووكلاء مختارين في كل سوق نعمل بها."}}, {"@type": "Question", "name": "كيف أبدأ محادثة مع Orion؟", "acceptedAnswer": {"@type": "Answer", "text": "تواصل معنا مباشرة عبر صفحة التواصل. تبدأ كل مهمة بمحادثة خاصة — دون ضغط، مجرد حوار حول أهدافك."}}, {"@type": "Question", "name": "هل يمكن لغير المواطن شراء عقار في دبي بملكية كاملة؟", "acceptedAnswer": {"@type": "Answer", "text": "نعم. في مناطق التملك الحر المحددة في دبي — بما في ذلك نخلة جميرا، وسط مدينة دبي، دبي مارينا، دبي هيلز إستيت، وإيمار بيتش فرونت — يمكن لغير المواطن الشراء بملكية حرة كاملة دون كفيل أو شريك محلي. خارج هذه المناطق، تبقى الملكية مقصورة على مواطني دول مجلس التعاون الخليجي أو تُنظَّم كإيجار طويل الأمد."}}, {"@type": "Question", "name": "هل يؤهّل شراء عقار في دبي للحصول على التأشيرة الذهبية الإماراتية؟", "acceptedAnswer": {"@type": "Answer", "text": "يؤهّل الاستثمار العقاري بقيمة 2 مليون درهم إماراتي أو أكثر (حوالي 545,000 دولار أمريكي) للحصول على التأشيرة الذهبية الإماراتية، وهي تصريح إقامة قابل للتجديد لمدة 10 سنوات دون الحاجة إلى كفيل صاحب عمل. من المهم التمييز بين التأشيرة والإقامة الضريبية: فالأخيرة لها متطلبات إضافية ينبغي مراجعتها مع مستشارك الضريبي قبل الشراء."}}, {"@type": "Question", "name": "هل من الأفضل الشراء على الخارطة أم شراء عقار جاهز في دبي؟", "acceptedAnswer": {"@type": "Answer", "text": "يعتمد ذلك على الأفق الزمني للمستثمر. تأتي المشتريات على الخارطة بخطط دفع متدرجة وإمكانية أكبر لارتفاع القيمة في المراحل المبكرة من مشروع جيد الموقع، لكنها تحمل مخاطر تنفيذ مرتبطة بالمطور. العقارات الجاهزة تقلّل هذه المخاطر لكنها تتطلب رأس مال فوري. تبقى سمعة المطور وسجل التسليم هما العامل الحاسم في الحالتين."}}, {"@type": "Question", "name": "ما هي التكاليف الحقيقية، إلى جانب السعر المعلن، لشراء عقار في دبي؟", "acceptedAnswer": {"@type": "Answer", "text": "خصص ميزانية لرسم نقل الملكية لدى دائرة الأراضي والأملاك في دبي (4% من قيمة العقار)، وعمولة الوكالة (عادة 2%)، وتكاليف التسجيل، ولرسوم نقل الخدمات في العقارات الجاهزة. في عقار فاخر، قد تصل هذه التكاليف الإضافية إلى 6-7% من القيمة الإجمالية."}}, {"@type": "Question", "name": "كيف تتحققون من موثوقية مطوّر في دبي من الخارج؟", "acceptedAnswer": {"@type": "Answer", "text": "يجب التحقق من التسجيل لدى دائرة الأراضي والأملاك في دبي، وسجل تسليم المطور لمشاريعه السابقة، والحماية الفعلية لحساب الضمان للمبالغ المدفوعة. تتطلب هذه الفحوصات حضورًا وعلاقات على الأرض، وهنا يُحدث الوسيط ذو المعرفة المباشرة بالسوق فرقًا كبيرًا في تقليل المخاطر مقارنة بصفقة تُدار بالكامل عبر الإنترنت."}}, {"@type": "Question", "name": "ما الذي تقوم به Orion بالضبط في عملية شراء العقار، وكيف تُعوَّض؟", "acceptedAnswer": {"@type": "Answer", "text": "تُعرّف Orion العملاء بفرص عقارية موثوقة قبل وصولها إلى التوزيع الواسع، وتُجري تحققًا أوليًا من المطور وحالة المشروع وهيكل الدفع. يعمل نموذجنا على أساس الأتعاب مقابل النجاح: نحصل على تعويضنا فقط عند إتمام الصفقة، ما يوائم مصلحتنا مع مصلحة العميل منذ المحادثة الأولى."}}, {"@type": "Question", "name": "هل يمكن الشراء في دبي دون السفر إليها شخصيًا؟", "acceptedAnswer": {"@type": "Answer", "text": "ذلك ممكن عبر التوكيل، لكنه غير مستحسن لشراء فاخر دون تحقق مباشر من الطرف المقابل، وحيثما أمكن، من العقار نفسه. يمكن لوسيط ذي حضور راسخ على الأرض أن يُجري جزءًا من العناية الواجبة نيابة عن العميل، لكن الزيارة، على الأقل في المرحلة النهائية، تبقى الممارسة الأكثر حكمة."}}, {"@type": "Question", "name": "كيف يتم التحقق من تاريخ الملكية وأصالة سيارة كلاسيكية قبل الشراء؟", "acceptedAnswer": {"@type": "Answer", "text": "يتضمن ملف تاريخ الملكية الموثوق سلسلة ملكية كاملة، وشهادات أصالة من المصنع حيثما توفرت (Ferrari Classiche، Porsche Certificate of Authenticity)، وأرقام هيكل ومحرك أصلية متطابقة، وتوثيقًا لأي أعمال ترميم أو هيكلية."}}, {"@type": "Question", "name": "هل يمكن طلب سيارة بتصميم فريد مباشرة من الشركة المصنّعة؟", "acceptedAnswer": {"@type": "Answer", "text": "توجد أرقى برامج التخصيص (Ferrari، Bentley Mulliner، Rolls-Royce Bespoke)، لكن الوصول إليها ليس تلقائيًا. عادة ما يتطلب ذلك علاقة سابقة مع الشركة المصنّعة، وسجل شراء ثابت، أو تعريفًا عبر قناة ذات مصداقية راسخة لدى الماركة."}}, {"@type": "Question", "name": "ما هي التبعات الجمركية والضريبية لاستيراد سيارة فاخرة؟", "acceptedAnswer": {"@type": "Answer", "text": "تخضع السيارة المشتراة خارج سوقك المحلي لرسوم جمركية، إضافة إلى ضريبة استيراد أو ضريبة مبيعات، وأي اعتماد مطلوب للاستخدام على الطرق إذا لم تكن السيارة متوافقة مسبقًا مع المعايير المحلية. بالنسبة للقطع المخصصة للعرض أو استخدام المضمار، تنطبق أنظمة جمركية مختلفة ينبغي تقييمها قبل الشراء."}}, {"@type": "Question", "name": "هل من الأفضل شراء سيارة كلاسيكية في مزاد أم عبر بيع خاص؟", "acceptedAnswer": {"@type": "Answer", "text": "توفّر المزادات شفافية في السعر لكنها تأتي مع علاوات شراء معتبرة وضغط اللحظة. يتيح التفاوض الخاص سرية أكبر وجدولًا زمنيًا أكثر اتزانًا لاتخاذ القرار، لكنه يتطلب وصولًا مباشرًا إلى بائعين مؤهلين. يعتمد الاختيار الصحيح على القطعة المحددة وأهداف المشتري، وليس على قاعدة عامة."}}, {"@type": "Question", "name": "كيف تُحدَّد القيمة الصحيحة لسيارة كلاسيكية نادرة؟", "acceptedAnswer": {"@type": "Answer", "text": "تعتمد القيمة على تاريخ الملكية، وندرة هذا التكوين المحدد، والحالة مقارنة بالمواصفات الأصلية، وتوقيت السوق لهذا الطراز تحديدًا، والذي قد يتحرك بشكل مستقل عن سوق المقتنيات الأوسع. يبقى التقييم المستقل، غير المرتبط بالبائع، المرجع الأكثر موثوقية."}}, {"@type": "Question", "name": "ما الفرق بين العمل مع وكيل والعمل مع وسيط خاص مثل Orion؟", "acceptedAnswer": {"@type": "Answer", "text": "يعمل الوكيل عادة لصالح البائع أو مخزونه الخاص. يعمل الوسيط الخاص حصريًا لصالح العميل، متكفلاً بالتحقق من تاريخ الملكية، والتفاوض السري، والوصول إلى قنوات التخصيص الحصرية، مع تعويض قائم على نموذج الأتعاب مقابل النجاح مرتبط بإتمام الصفقة."}}, {"@type": "Question", "name": "كيف توثقون ساعة عتيقة أو نادرة قبل الشراء؟", "acceptedAnswer": {"@type": "Answer", "text": "يعني التوثيق التحقق من الحركة والميناء والعلبة والمكونات مقارنةً بالمواصفات الأصلية من المصنع. تُعد شهادات الصيانة من دار الصناعة، ومقتطف من الأرشيف حيثما توفر، وفحص مستقل من صانع ساعات مؤهل، الأدوات الأكثر موثوقية، وليس فاتورة الشراء الأصلية وحدها."}}, {"@type": "Question", "name": "هل يمكن تجاوز قوائم انتظار المتاجر للحصول على أكثر الطرازات طلبًا؟", "acceptedAnswer": {"@type": "Answer", "text": "ترتبط قائمة انتظار المتجر الرسمية بعلاقة شراء سابقة مع ذلك الفرع تحديدًا، وليس بترتيب الطلب الزمني. يبقى السوق الثانوي الطريق الأكثر مباشرة للحصول على قطعة مطلوبة الآن، لكنه يأتي بعلاوة فوق سعر التجزئة."}}, {"@type": "Question", "name": "ما هو أفضل وقت لبيع قطعة من مجموعة ساعات؟", "acceptedAnswer": {"@type": "Answer", "text": "يعتمد ذلك على الطراز المحدد أكثر من اعتماده على السوق الأوسع. تحافظ بعض الطرازات على قيمتها بثبات بينما تمر أخرى بدورات طلب واضحة، غالبًا ما ترتبط بإعلانات وقف الإنتاج أو إطلاق نسخ جديدة من العلامة. يُعد التقييم المحدث لهذا الطراز تحديدًا نقطة الانطلاق الصحيحة."}}, {"@type": "Question", "name": "كيف تُحفَظ السرية عند بيع مجموعة ساعات خاصة؟", "acceptedAnswer": {"@type": "Answer", "text": "من خلال تجنب الكشف العلني عن الحيازات، وإدارة التفاوض مع عدد محدود من المشترين المؤهلين، والتحقق من الملاءة المالية للطرف المقابل قبل المضي قدمًا. تدير القناة الخاصة هذه الجوانب بطريقة أكثر تحكمًا من البيع المفتوح في السوق."}}, {"@type": "Question", "name": "ما هي الوثائق اللازمة للتأمين على ساعة عالية القيمة؟", "acceptedAnswer": {"@type": "Answer", "text": "تحتاج إلى تقييم مهني محدث، يُجدَّد دوريًا لأن قيم السوق تتغير، وصورًا تفصيلية للعلبة والحركة، ووثائق أصلية محفوظة بمعزل عن القطعة نفسها. تُفضَّل بوليصة مخصصة على التغطية العامة لتأمين المنازل، التي غالبًا ما تفرض حدودًا غير كافية لكل قطعة."}}, {"@type": "Question", "name": "ما الفرق بين الشراء من وكيل معتمد وعبر وسيط خاص؟", "acceptedAnswer": {"@type": "Answer", "text": "يعمل الوكيل المعتمد لصالح دار الصناعة التي يمثّلها. يعمل الوسيط الخاص حصريًا لصالح العميل، من الشراء وحتى البيع، مع تعويض مرتبط بإتمام الصفقة وفق شروط يوافق عليها العميل."}}]}</script>
